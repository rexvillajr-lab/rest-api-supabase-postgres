NODE_ENV=development
PORT=3000

# Comma-separated frontend URLs allowed by CORS.
# Development can use localhost. Production should use your deployed frontend URL.
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Postgres connection string.
# Use the pooled connection string for serverless/short-lived connections,
# or the direct connection string for long-running backend servers.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Optional: keep Supabase API keys here only if this backend calls Supabase APIs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

JWT_SECRET=your_generated_value_here
