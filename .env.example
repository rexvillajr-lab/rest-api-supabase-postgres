NODE_ENV=development
PORT=3000

# Supabase Postgres connection string.
# Use the pooled connection string for serverless/short-lived connections,
# or the direct connection string for long-running backend servers.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Optional: keep Supabase API keys here only if this backend calls Supabase APIs.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
